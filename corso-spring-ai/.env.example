# Copia questo file in ".env" (stessa cartella) e incolla la tua chiave.
# Il file .env NON va su Git: è già in .gitignore.
#
# Chiave gratuita: https://console.groq.com/keys  → "Create API Key"
GROQ_API_KEY=incolla-qui-la-chiave

# Solo per il profilo "openai" o "multi":
# OPENAI_API_KEY=incolla-qui-la-chiave
